# Local environment for `docker compose up` (read from fyp-be/.env).
# Copy to .env and fill in the values. .env is git-ignored; never commit real keys.
# Use your OWN cloud resources here: do not point this at another team's account.

# --- Required: compose refuses to start without these ---------------------
# Cognito user pool, and the SPA app client (public client, no secret).
# Several client IDs may be comma-separated (e.g. the frontend's and Postman's).
AWS_COGNITO_USER_POOL_ID=ap-southeast-1_xxxxxxxxx
AWS_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# IAM credentials the API uses for S3 (presigned URLs), SQS and Cognito admin calls.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AWS region -----------------------------------------------------------
AWS_REGION=ap-southeast-1
AWS_COGNITO_REGION=ap-southeast-1

# --- Storage --------------------------------------------------------------
# Upload bucket (needs a CORS rule allowing PUT from the frontend origin)
# and the bucket Transcribe writes transcripts to.
S3_BUCKET=ingestion-audio
TRANSCRIBE_OUTPUT_BUCKET=ingestion-audio-output
S3_PRESIGNED_URL_EXPIRY_MINUTES=15

# --- Browser access -------------------------------------------------------
# The Vite dev server runs on 5173; compose's own default (3000) does not match it.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Users ----------------------------------------------------------------
# Comma-separated emails that become SUPER_ADMIN on their first sign-in.
BOOTSTRAP_ADMIN_EMAILS=you@example.com
# Permanent password given to users created through POST /api/users.
DEFAULT_USER_PASSWORD=ChangeMe123!

# --- Transcription pipeline (optional) ------------------------------------
# Leave blank to keep the SQS pollers off: uploads then stay PENDING and no AI analysis runs.
TRANSCRIBE_STATUS_QUEUE_URL=
TRANSCRIPT_HANDOFF_QUEUE_URL=

# --- AI service (fyp-ai) --------------------------------------------------
# fyp-ai running on the host, e.g. `docker run -p 2024:2024 ...`.
AI_BASE_URL=http://host.docker.internal:2024
# Default compliance checklist as JSON; {} lets fyp-ai use its built-in one.
CHECKLIST_JSON={}
