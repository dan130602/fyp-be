# Copy to .env (git-ignored) and fill in. This file is the only place the evaluation reads secrets from;
# the outer fyp-be/.env is never used.

# AWS access (the same user you use for Polly in evaluation-dataset/.env works if it has the permissions in README.md)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # only for temporary credentials
AWS_REGION=ap-southeast-1       # Singapore, the production region

# The evaluation bucket (NOT a production bucket). Holds the audio and Transcribe's output.
EVAL_BUCKET=

# Optional: mirror production's Lambda settings. Production uses en-US and 2 speakers (infra/), the same as the handler's defaults,
# so these can stay empty or be deleted. Set them only if production changes.
TRANSCRIBE_LANGUAGE_CODE=
# Production language identification: comma separated, at least two (e.g. en-US,zh-CN); empty = the single code above
TRANSCRIBE_LANGUAGE_OPTIONS=
TRANSCRIBE_LANGUAGE_ID_MODE=
TRANSCRIBE_MAX_SPEAKER_LABELS=
