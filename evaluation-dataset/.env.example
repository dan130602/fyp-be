# Copy to .env in this directory (evaluation-dataset/) and fill in locally. .env is git-ignored.
# Real operating-system environment variables take precedence over this file.
# Model IDs are NOT configured here; they are version-controlled (call_configs/config.py for G3/G4, plan_verifications/config.py for G5).
# OPENAI_API_KEY is used by G3/G4; GEMINI_API_KEY is used by G5.
OPENAI_API_KEY=
GEMINI_API_KEY=
