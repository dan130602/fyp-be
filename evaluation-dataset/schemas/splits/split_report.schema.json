{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fyp-evaluation.invalid/schemas/splits/split_report.schema.json",
  "title": "Balance and limitation report of the frozen split",
  "type": "object",
  "required": ["schema_version", "split_version", "dataset_id", "manifest_inputs", "counts", "by_language", "search", "balance", "max_abs_deviation_by_group", "rare_labels", "labels_unreachable_with_locks", "long_heldout_total", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "split_version": {"const": "split.v1"},
    "counts": {"type": "object", "required": ["calls", "development", "heldout", "development_locks", "user_given_locks", "audit_derived_locks"]},
    "by_language": {"type": "object"},
    "balance": {
      "type": "array",
      "items": {"type": "object", "required": ["label", "group", "calls", "heldout", "development", "target_heldout", "deviation", "locked_calls", "unlocked_calls"]}
    },
    "rare_labels": {"type": "array", "items": {"type": "object", "required": ["label", "calls", "call_ids", "assignments", "note"]}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
