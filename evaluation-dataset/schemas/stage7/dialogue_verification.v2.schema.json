{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fyp-evaluation.invalid/schemas/stage7/dialogue_verification.v2.schema.json",
  "title": "G7 dialogue_verification (schema 2.0, multilingual releases)",
  "description": "A completed semantic verification of one call's accepted G6 dialogue against the frozen gold and assigned edge cases. The verdict, recommended repair and quality review are derived by Python from the validated assessments, issues and findings; every evidence quote is the exact substring of the cited actual dialogue turn, with derived turn-local spans. A completed report may be VALID, INVALID or UNCLEAR; quality_review is advisory and never changes the verdict. Only a current, intact VALID report makes a call G8-eligible.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "stage": {
      "const": "G7"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "call_id": {
      "type": "string",
      "pattern": "^CALL_[0-9]{3,}$"
    },
    "call_spec_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "check_plan_skeleton_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "call_config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "check_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "plan_verification_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "dialogue_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source": {
      "type": "object",
      "properties": {
        "checklist_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "check_semantics_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "edge_case_catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalization_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generation_plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "language_profiles_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "register_guide_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "checklist_sha256",
        "check_semantics_sha256",
        "edge_case_catalog_sha256",
        "normalization_sha256",
        "generation_plan_sha256",
        "language_profiles_sha256"
      ],
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^A[0-9]{3,}$"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "thinking_level": {
                  "const": "high"
                },
                "service_tier": {
                  "const": "flex"
                },
                "max_output_tokens": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "thinking_level",
                "service_tier",
                "max_output_tokens"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "method": {
                  "const": "manual_review"
                },
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewer_model": {
                  "type": "string",
                  "minLength": 1
                },
                "request_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "method",
                "reviewer",
                "reviewer_model",
                "request_sha256"
              ],
              "additionalProperties": false
            }
          ]
        },
        "prompt_template_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "response_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "accepted_response_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "attempt_id",
        "model",
        "params",
        "prompt_template_sha256",
        "response_schema_sha256",
        "accepted_response_sha256"
      ],
      "additionalProperties": false
    },
    "verdict": {
      "enum": [
        "VALID",
        "INVALID",
        "UNCLEAR"
      ]
    },
    "recommended_repair": {
      "enum": [
        null,
        "G6_ONLY",
        "UPSTREAM_REVIEW",
        "REVIEW"
      ]
    },
    "quality_review": {
      "enum": [
        "CLEAR",
        "REVIEW_REQUIRED"
      ]
    },
    "summary": {
      "type": "object",
      "properties": {
        "checks": {
          "$ref": "#/$defs/counts"
        },
        "edge_cases": {
          "$ref": "#/$defs/counts"
        },
        "issues_by_code": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "quality_by_severity": {
          "type": "object",
          "properties": {
            "NOTE": {
              "type": "integer",
              "minimum": 0
            },
            "SERIOUS": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "NOTE",
            "SERIOUS"
          ],
          "additionalProperties": false
        },
        "language_checks": {
          "$ref": "#/$defs/counts"
        }
      },
      "required": [
        "checks",
        "edge_cases",
        "issues_by_code",
        "quality_by_severity",
        "language_checks"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "COMPLIANCE",
              "EXTRACTION"
            ]
          },
          "expected": {
            "type": "object"
          },
          "assessment": {
            "enum": [
              "MATCH",
              "MISMATCH",
              "UNCLEAR"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "issue_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "question_id",
          "kind",
          "expected",
          "assessment",
          "rationale",
          "evidence",
          "issue_ids"
        ],
        "additionalProperties": false
      }
    },
    "edge_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assignment_id": {
            "type": "string"
          },
          "edge_case_id": {
            "type": "string"
          },
          "target_question_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assessment": {
            "enum": [
              "MATCH",
              "MISMATCH",
              "UNCLEAR"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "issue_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "assignment_id",
          "edge_case_id",
          "target_question_ids",
          "assessment",
          "rationale",
          "evidence",
          "issue_ids"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string",
            "pattern": "^I[1-9][0-9]*$"
          },
          "assessment": {
            "enum": [
              "MISMATCH",
              "UNCLEAR"
            ]
          },
          "code": {
            "enum": [
              "COMPLIANCE_MEANING",
              "OMISSION_LEAKAGE",
              "EXTRACTION_STATE",
              "SCENARIO_CONTRADICTION",
              "EDGE_CASE",
              "CROSS_CHECK_INTERFERENCE",
              "MISSING_SUPPORT",
              "LANGUAGE_REQUIREMENT_NOT_MET"
            ]
          },
          "question_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assignment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "repair_scope": {
            "enum": [
              "G6_ONLY",
              "UPSTREAM_REVIEW",
              "REVIEW"
            ]
          },
          "language_row_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "issue_id",
          "assessment",
          "code",
          "question_ids",
          "assignment_ids",
          "evidence",
          "explanation",
          "repair_scope",
          "language_row_ids"
        ],
        "additionalProperties": false
      }
    },
    "quality_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quality_id": {
            "type": "string",
            "pattern": "^Q[1-9][0-9]*$"
          },
          "severity": {
            "enum": [
              "NOTE",
              "SERIOUS"
            ]
          },
          "code": {
            "enum": [
              "REPETITION",
              "ARTIFICIAL_EXTENSION",
              "INCOHERENT_FLOW",
              "IMPLAUSIBLE_TURN",
              "SPEAKER_ROLE",
              "LANGUAGE_NATURALNESS"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "quality_id",
          "severity",
          "code",
          "evidence",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "language_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "row_id": {
            "type": "string"
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "assessment": {
            "enum": [
              "MATCH",
              "MISMATCH",
              "UNCLEAR"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "issue_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "row_id",
          "requirement",
          "assessment",
          "rationale",
          "evidence",
          "issue_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "stage",
    "dataset_id",
    "call_id",
    "call_spec_sha256",
    "check_plan_skeleton_sha256",
    "call_config_sha256",
    "check_plan_sha256",
    "plan_verification_sha256",
    "dialogue_sha256",
    "source",
    "generation",
    "verdict",
    "recommended_repair",
    "quality_review",
    "summary",
    "checks",
    "edge_cases",
    "issues",
    "quality_findings",
    "language_checks"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "properties": {
        "match": {
          "type": "integer",
          "minimum": 0
        },
        "mismatch": {
          "type": "integer",
          "minimum": 0
        },
        "unclear": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "match",
        "mismatch",
        "unclear"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "turn_id": {
          "type": "integer",
          "minimum": 0
        },
        "speaker": {
          "enum": [
            "EMPLOYEE",
            "CLIENT"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "description": "The exact substring of the cited turn's text that the model's quote grounds to."
        },
        "spans": {
          "type": "array",
          "minItems": 1,
          "description": "Every matching occurrence of the quote in that turn: zero-based Unicode code-point offsets [start, end), start inclusive. More than one entry means the quote repeats in the turn.",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "event_ids": {
          "type": "array",
          "description": "Planned events whose G6 span overlaps any matching occurrence (derived by Python; empty for supporting speech).",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "turn_id",
        "speaker",
        "quote",
        "spans",
        "event_ids"
      ],
      "additionalProperties": false
    }
  }
}
