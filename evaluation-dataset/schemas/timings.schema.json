{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fyp-evaluation.invalid/schemas/timings.schema.json",
  "title": "Timings",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "call_id": {
      "type": "string",
      "pattern": "^CALL_[0-9]{3,}$"
    },
    "render_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "audio_file": {
      "const": "audio.mp3"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "turn_id": {
            "type": "integer",
            "minimum": 0
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "minimum": 0
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "start_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "end_seconds": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "text",
                "start_seconds",
                "end_seconds"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "turn_id",
          "start_seconds",
          "end_seconds"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "call_id",
    "render_id",
    "audio_file",
    "duration_seconds",
    "turns"
  ],
  "additionalProperties": false
}
