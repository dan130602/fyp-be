{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fyp-evaluation.invalid/schemas/stage0/language_profiles.schema.json",
  "title": "Release Language Profiles",
  "description": "Spoken-language behaviour per language profile (multilingual releases only). Profiles constrain dialogue, never gold values.",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "description",
    "languages",
    "profiles",
    "terminology"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "description": {
      "$ref": "#/$defs/text"
    },
    "languages": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/language"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "script"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/$defs/text"
          },
          "script": {
            "enum": [
              "LATIN",
              "SIMPLIFIED_HAN"
            ]
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/symbol"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "terminology": {
      "type": "object",
      "required": [
        "note"
      ],
      "properties": {
        "note": {
          "$ref": "#/$defs/text"
        }
      },
      "propertyNames": {
        "anyOf": [
          {
            "const": "note"
          },
          {
            "$ref": "#/$defs/language"
          }
        ]
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "$ref": "#/$defs/symbol"
        },
        "additionalProperties": {
          "type": "object",
          "required": [
            "formal",
            "ordinary",
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "formal": {
              "$ref": "#/$defs/text"
            },
            "ordinary": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "status": {
              "$ref": "#/$defs/approval"
            },
            "note": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/language"
      }
    },
    "approval": {
      "enum": [
        "APPROVED",
        "PENDING"
      ]
    },
    "script_rule": {
      "enum": [
        "ALLOWED",
        "FORBIDDEN",
        "K01_IDENTIFIER_SPAN_ONLY"
      ]
    },
    "speaker": {
      "type": "object",
      "required": [
        "spoken_languages",
        "required_languages",
        "register",
        "guidance"
      ],
      "additionalProperties": false,
      "properties": {
        "spoken_languages": {
          "allOf": [
            {
              "$ref": "#/$defs/languages"
            },
            {
              "minItems": 1
            }
          ]
        },
        "required_languages": {
          "$ref": "#/$defs/languages"
        },
        "register": {
          "$ref": "#/$defs/symbol"
        },
        "within_turn_switching_required": {
          "type": "boolean"
        },
        "distributed_switching_required": {
          "type": "boolean"
        },
        "guidance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "description",
        "value_surface_languages",
        "product_name_languages",
        "script_rules",
        "speakers"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/$defs/text"
        },
        "value_surface_languages": {
          "allOf": [
            {
              "$ref": "#/$defs/languages"
            },
            {
              "minItems": 1
            }
          ]
        },
        "product_name_languages": {
          "allOf": [
            {
              "$ref": "#/$defs/languages"
            },
            {
              "minItems": 1
            }
          ]
        },
        "script_rules": {
          "type": "object",
          "required": [
            "han_characters",
            "latin_letters",
            "arabic_digits"
          ],
          "additionalProperties": false,
          "properties": {
            "han_characters": {
              "$ref": "#/$defs/script_rule"
            },
            "latin_letters": {
              "$ref": "#/$defs/script_rule"
            },
            "arabic_digits": {
              "$ref": "#/$defs/script_rule"
            }
          }
        },
        "speakers": {
          "type": "object",
          "required": [
            "CLIENT",
            "EMPLOYEE"
          ],
          "additionalProperties": false,
          "properties": {
            "CLIENT": {
              "$ref": "#/$defs/speaker"
            },
            "EMPLOYEE": {
              "$ref": "#/$defs/speaker"
            }
          }
        },
        "mixing_styles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/symbol"
          },
          "additionalProperties": {
            "$ref": "#/$defs/text"
          }
        }
      }
    }
  }
}
