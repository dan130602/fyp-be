{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fyp-evaluation.invalid/schemas/stage0/generation_plan.schema.json",
  "title": "Release Generation Plan",
  "description": "G1 planning inputs. Allocations are exact integer counts; floating-point fractions are not accepted.",
  "type": "object",
  "required": [
    "schema_version",
    "description",
    "num_calls",
    "random_seed",
    "language_counts",
    "duration_profiles",
    "call_intent_vocabulary",
    "call_intent_set_counts",
    "question_scope",
    "call_composition_counts",
    "compliance_distribution",
    "edge_case_distribution",
    "extraction_distribution",
    "planning_rules"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "description": {
      "$ref": "#/$defs/text"
    },
    "num_calls": {
      "type": "integer",
      "minimum": 1
    },
    "random_seed": {
      "type": "integer",
      "minimum": 0
    },
    "language_counts": {
      "$ref": "#/$defs/count_map"
    },
    "duration_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "profile",
          "count",
          "min_seconds",
          "max_seconds"
        ],
        "additionalProperties": false,
        "properties": {
          "profile": {
            "$ref": "#/$defs/symbol"
          },
          "count": {
            "$ref": "#/$defs/count"
          },
          "min_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "max_seconds": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "call_intent_vocabulary": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },
    "call_intent_set_counts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "call_intents",
          "count"
        ],
        "additionalProperties": false,
        "properties": {
          "call_intents": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/symbol"
            }
          },
          "count": {
            "$ref": "#/$defs/count"
          }
        }
      }
    },
    "question_scope": {
      "type": "object",
      "required": [
        "strategy"
      ],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "const": "ALL_CHECKLIST_QUESTIONS"
        }
      }
    },
    "call_composition_counts": {
      "type": "object",
      "required": [
        "all_pass_without_edge_cases",
        "all_pass_with_edge_cases",
        "some_fail_without_edge_cases",
        "some_fail_with_edge_cases"
      ],
      "additionalProperties": false,
      "properties": {
        "all_pass_without_edge_cases": {
          "$ref": "#/$defs/count"
        },
        "all_pass_with_edge_cases": {
          "$ref": "#/$defs/count"
        },
        "some_fail_without_edge_cases": {
          "$ref": "#/$defs/count"
        },
        "some_fail_with_edge_cases": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "compliance_distribution": {
      "type": "object",
      "required": [
        "fail_count_per_call_counts",
        "min_fail_cases_per_check"
      ],
      "additionalProperties": false,
      "properties": {
        "fail_count_per_call_counts": {
          "$ref": "#/$defs/per_call_counts"
        },
        "min_fail_cases_per_check": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "edge_case_distribution": {
      "type": "object",
      "required": [
        "edge_cases_per_call_counts",
        "selection_strategy_within_family",
        "family_quotas"
      ],
      "additionalProperties": false,
      "properties": {
        "edge_cases_per_call_counts": {
          "$ref": "#/$defs/per_call_counts"
        },
        "selection_strategy_within_family": {
          "const": "BALANCED"
        },
        "family_quotas": {
          "$ref": "#/$defs/count_map"
        }
      }
    },
    "extraction_distribution": {
      "type": "object",
      "required": [
        "transaction_direction_counts",
        "order_type_counts",
        "transaction_currency_counts",
        "product_pool",
        "transaction_amount_values_by_currency",
        "transaction_quantity_values",
        "amount_quantity_coherence",
        "synthetic_kyc"
      ],
      "additionalProperties": false,
      "properties": {
        "transaction_direction_counts": {
          "$ref": "#/$defs/count_map"
        },
        "order_type_counts": {
          "$ref": "#/$defs/count_map"
        },
        "transaction_currency_counts": {
          "$ref": "#/$defs/count_map"
        },
        "product_pool": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "category",
              "allowed_currencies"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "#/$defs/text"
              },
              "category": {
                "$ref": "#/$defs/symbol"
              },
              "allowed_currencies": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/currency_code"
                }
              }
            }
          }
        },
        "transaction_amount_values_by_currency": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/currency_code"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "transaction_quantity_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "amount_quantity_coherence": {
          "type": "object",
          "required": [
            "strategy",
            "ranges",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "const": "IMPLIED_UNIT_PRICE_RANGE_BY_CURRENCY"
            },
            "ranges": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/currency_code"
              },
              "additionalProperties": {
                "type": "object",
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false,
                "properties": {
                  "min": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "max": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            },
            "note": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "synthetic_kyc": {
          "type": "object",
          "required": [
            "nric_fin",
            "dob"
          ],
          "additionalProperties": false,
          "properties": {
            "nric_fin": {
              "type": "object",
              "required": [
                "synthetic_only",
                "prefixes",
                "digit_count",
                "suffix_letters",
                "require_checksum_invalid",
                "unique_within_dataset"
              ],
              "additionalProperties": false,
              "properties": {
                "synthetic_only": {
                  "const": true
                },
                "prefixes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z]$"
                  }
                },
                "digit_count": {
                  "const": 7
                },
                "suffix_letters": {
                  "type": "string",
                  "pattern": "^[A-Z]+$"
                },
                "require_checksum_invalid": {
                  "const": true
                },
                "unique_within_dataset": {
                  "const": true
                }
              }
            },
            "dob": {
              "type": "object",
              "required": [
                "min_date",
                "max_date",
                "unique_within_dataset"
              ],
              "additionalProperties": false,
              "properties": {
                "min_date": {
                  "$ref": "#/$defs/iso_date"
                },
                "max_date": {
                  "$ref": "#/$defs/iso_date"
                },
                "unique_within_dataset": {
                  "const": true
                }
              }
            }
          }
        }
      }
    },
    "planning_rules": {
      "type": "object",
      "required": [
        "g1_must_be_deterministic",
        "g1_must_not_use_llm",
        "coverage_matrix_is_source_of_truth_for_check_answers",
        "call_manifest_is_source_of_truth_for_call_level_attributes",
        "edge_case_assignments_are_source_of_truth_for_challenge_placement",
        "allocate_edge_cases_and_compliance_verdicts_jointly",
        "edge_case_forced_verdicts_count_toward_failure_budget",
        "gold_values_must_satisfy_edge_case_prerequisites_when_assigned",
        "complete_order_replacement_excludes_other_transaction_correction_edge_cases_in_same_call",
        "max_edge_cases_per_target_question_per_call",
        "per_question_limit_exempt_edge_cases",
        "superseded_and_distractor_values_must_satisfy_domain_and_realism_constraints",
        "complete_order_replacement_initial_order_must_be_plausible",
        "no_fee_distractor_when_c04_fail",
        "unspecified_choices_strategy",
        "call_intents_are_multilabel",
        "call_intents_are_descriptive_only",
        "call_intent_vocabulary_order_is_canonical",
        "call_intents_csv_encoding",
        "call_intents_json_encoding"
      ],
      "additionalProperties": false,
      "properties": {
        "g1_must_be_deterministic": {
          "const": true
        },
        "g1_must_not_use_llm": {
          "const": true
        },
        "coverage_matrix_is_source_of_truth_for_check_answers": {
          "const": true
        },
        "call_manifest_is_source_of_truth_for_call_level_attributes": {
          "const": true
        },
        "edge_case_assignments_are_source_of_truth_for_challenge_placement": {
          "const": true
        },
        "allocate_edge_cases_and_compliance_verdicts_jointly": {
          "const": true
        },
        "edge_case_forced_verdicts_count_toward_failure_budget": {
          "const": true
        },
        "gold_values_must_satisfy_edge_case_prerequisites_when_assigned": {
          "const": true
        },
        "complete_order_replacement_excludes_other_transaction_correction_edge_cases_in_same_call": {
          "const": true
        },
        "max_edge_cases_per_target_question_per_call": {
          "const": 1
        },
        "per_question_limit_exempt_edge_cases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EC_[A-Z0-9_]+$"
          }
        },
        "superseded_and_distractor_values_must_satisfy_domain_and_realism_constraints": {
          "const": true
        },
        "complete_order_replacement_initial_order_must_be_plausible": {
          "const": true
        },
        "no_fee_distractor_when_c04_fail": {
          "const": true
        },
        "unspecified_choices_strategy": {
          "const": "SEEDED_BALANCED_STABLE_TIE_BREAK"
        },
        "call_intents_are_multilabel": {
          "const": true
        },
        "call_intents_are_descriptive_only": {
          "const": true
        },
        "call_intent_vocabulary_order_is_canonical": {
          "const": true
        },
        "call_intents_csv_encoding": {
          "const": "PIPE_DELIMITED"
        },
        "call_intents_json_encoding": {
          "const": "ARRAY"
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "currency_code": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "iso_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "count_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/count"
      }
    },
    "per_call_counts": {
      "description": "Number of calls having exactly N items, keyed by the decimal string of N.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(0|[1-9][0-9]*)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/count"
      }
    }
  }
}
