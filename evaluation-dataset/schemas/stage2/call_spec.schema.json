{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fyp-evaluation.invalid/schemas/stage2/call_spec.schema.json",
  "title": "G2A Call Spec",
  "description": "Immutable per-call truth compiled from the frozen G1 outputs. Nothing here may be changed by a later stage. Numbers are represented as JSON integers in this release. Schema 2.0 (multilingual releases) replaces metadata.language with language_profile and mixing_style, adds the frozen language_requirements snapshot, a language_variant on every edge case and the language_profiles.json hash in source.",
  "type": "object",
  "required": [
    "schema_version",
    "stage",
    "dataset_id",
    "call_id",
    "metadata",
    "gold",
    "edge_cases",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "2.0"
      ]
    },
    "stage": {
      "const": "G2A"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "call_id": {
      "type": "string",
      "pattern": "^CALL_[0-9]{3,}$"
    },
    "metadata": {
      "type": "object",
      "required": [
        "call_intents",
        "duration_profile",
        "target_duration_min_seconds",
        "target_duration_max_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "call_intents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "language": {
          "$ref": "#/$defs/text"
        },
        "duration_profile": {
          "$ref": "#/$defs/symbol"
        },
        "target_duration_min_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "target_duration_max_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "language_profile": {
          "$ref": "#/$defs/symbol"
        },
        "mixing_style": {
          "$ref": "#/$defs/symbol"
        }
      }
    },
    "gold": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "question_id": {
            "$ref": "#/$defs/identifier"
          },
          "expected": {
            "$ref": "#/$defs/expected"
          }
        }
      }
    },
    "edge_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assignment_id",
          "edge_case_id",
          "family",
          "target_question_ids",
          "parameters"
        ],
        "additionalProperties": false,
        "properties": {
          "assignment_id": {
            "type": "string",
            "pattern": "^EA_[0-9]{3,}$"
          },
          "edge_case_id": {
            "type": "string",
            "pattern": "^EC_[A-Z0-9_]+$"
          },
          "family": {
            "$ref": "#/$defs/symbol"
          },
          "target_question_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "parameters": {
            "type": "object"
          },
          "language_variant": {
            "$ref": "#/$defs/symbol"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "planning_record_sha256",
        "call_manifest_sha256",
        "coverage_matrix_sha256",
        "edge_case_assignments_sha256",
        "checklist_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "planning_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "call_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "coverage_matrix_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "edge_case_assignments_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "checklist_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "language_profiles_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "language_requirements": {
      "$ref": "#/$defs/language_requirements"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "expected_verdict"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "compliance"
            },
            "expected_verdict": {
              "enum": [
                "PASS",
                "FAIL"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value_type",
            "expected_value"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "extraction"
            },
            "value_type": {
              "const": "text"
            },
            "expected_value": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value_type",
            "expected_value"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "extraction"
            },
            "value_type": {
              "const": "integer"
            },
            "expected_value": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value_type",
            "expected_value"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "extraction"
            },
            "value_type": {
              "const": "number"
            },
            "expected_value": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value_type",
            "expected_value"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "extraction"
            },
            "value_type": {
              "const": "dob_dd_month_yyyy"
            },
            "expected_value": {
              "type": "string",
              "pattern": "^(0[1-9]|[12][0-9]|3[01]) (January|February|March|April|May|June|July|August|September|October|November|December) [0-9]{4}$"
            }
          }
        }
      ]
    },
    "language_requirements": {
      "type": "object",
      "required": [
        "value_surface_languages",
        "product_name_languages",
        "script_rules",
        "speakers"
      ],
      "additionalProperties": false,
      "properties": {
        "value_surface_languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          }
        },
        "product_name_languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          }
        },
        "script_rules": {
          "type": "object",
          "required": [
            "han_characters",
            "latin_letters",
            "arabic_digits"
          ],
          "additionalProperties": false,
          "properties": {
            "han_characters": {
              "enum": [
                "ALLOWED",
                "FORBIDDEN",
                "K01_IDENTIFIER_SPAN_ONLY"
              ]
            },
            "latin_letters": {
              "enum": [
                "ALLOWED",
                "FORBIDDEN",
                "K01_IDENTIFIER_SPAN_ONLY"
              ]
            },
            "arabic_digits": {
              "enum": [
                "ALLOWED",
                "FORBIDDEN",
                "K01_IDENTIFIER_SPAN_ONLY"
              ]
            }
          }
        },
        "speakers": {
          "type": "object",
          "required": [
            "CLIENT",
            "EMPLOYEE"
          ],
          "additionalProperties": false,
          "properties": {
            "CLIENT": {
              "type": "object",
              "required": [
                "spoken_languages",
                "required_languages",
                "register",
                "guidance"
              ],
              "additionalProperties": false,
              "properties": {
                "spoken_languages": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z]{2}$"
                  }
                },
                "required_languages": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z]{2}$"
                  }
                },
                "register": {
                  "$ref": "#/$defs/symbol"
                },
                "within_turn_switching_required": {
                  "type": "boolean"
                },
                "distributed_switching_required": {
                  "type": "boolean"
                },
                "guidance": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            },
            "EMPLOYEE": {
              "type": "object",
              "required": [
                "spoken_languages",
                "required_languages",
                "register",
                "guidance"
              ],
              "additionalProperties": false,
              "properties": {
                "spoken_languages": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z]{2}$"
                  }
                },
                "required_languages": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z]{2}$"
                  }
                },
                "register": {
                  "$ref": "#/$defs/symbol"
                },
                "within_turn_switching_required": {
                  "type": "boolean"
                },
                "distributed_switching_required": {
                  "type": "boolean"
                },
                "guidance": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            }
          }
        },
        "mixing_style_description": {
          "$ref": "#/$defs/text"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "2.0"
          }
        }
      },
      "then": {
        "required": [
          "language_requirements"
        ],
        "properties": {
          "metadata": {
            "required": [
              "language_profile",
              "mixing_style"
            ],
            "not": {
              "required": [
                "language"
              ]
            }
          },
          "edge_cases": {
            "items": {
              "required": [
                "language_variant"
              ]
            }
          },
          "source": {
            "required": [
              "language_profiles_sha256"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "metadata": {
            "required": [
              "language"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "language_profile"
                  ]
                },
                {
                  "required": [
                    "mixing_style"
                  ]
                }
              ]
            }
          },
          "edge_cases": {
            "items": {
              "not": {
                "required": [
                  "language_variant"
                ]
              }
            }
          },
          "source": {
            "not": {
              "required": [
                "language_profiles_sha256"
              ]
            }
          }
        },
        "not": {
          "required": [
            "language_requirements"
          ]
        }
      }
    }
  ]
}
