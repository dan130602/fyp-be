{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fyp-evaluation.invalid/schemas/stage2/call_spec.schema.json",
  "title": "G2A Call Spec",
  "description": "Immutable per-call truth compiled from the frozen G1 outputs. Nothing here may be changed by a later stage. Numbers are represented as JSON integers in this release.",
  "type": "object",
  "required": [
    "schema_version",
    "stage",
    "dataset_id",
    "call_id",
    "metadata",
    "gold",
    "edge_cases",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "stage": {
      "const": "G2A"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "call_id": {
      "type": "string",
      "pattern": "^CALL_[0-9]{3,}$"
    },
    "metadata": {
      "type": "object",
      "required": [
        "call_intents",
        "language",
        "duration_profile",
        "target_duration_min_seconds",
        "target_duration_max_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "call_intents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "language": {
          "$ref": "#/$defs/text"
        },
        "duration_profile": {
          "$ref": "#/$defs/symbol"
        },
        "target_duration_min_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "target_duration_max_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "gold": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "question_id": {
            "$ref": "#/$defs/identifier"
          },
          "expected": {
            "$ref": "#/$defs/expected"
          }
        }
      }
    },
    "edge_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assignment_id",
          "edge_case_id",
          "family",
          "target_question_ids",
          "parameters"
        ],
        "additionalProperties": false,
        "properties": {
          "assignment_id": {
            "type": "string",
            "pattern": "^EA_[0-9]{3,}$"
          },
          "edge_case_id": {
            "type": "string",
            "pattern": "^EC_[A-Z0-9_]+$"
          },
          "family": {
            "$ref": "#/$defs/symbol"
          },
          "target_question_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "parameters": {
            "type": "object"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "planning_record_sha256",
        "call_manifest_sha256",
        "coverage_matrix_sha256",
        "edge_case_assignments_sha256",
        "checklist_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "planning_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "call_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "coverage_matrix_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "edge_case_assignments_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "checklist_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "expected_verdict"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "compliance"
            },
            "expected_verdict": {
              "enum": [
                "PASS",
                "FAIL"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value_type",
            "expected_value"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "extraction"
            },
            "value_type": {
              "const": "text"
            },
            "expected_value": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value_type",
            "expected_value"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "extraction"
            },
            "value_type": {
              "const": "integer"
            },
            "expected_value": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value_type",
            "expected_value"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "extraction"
            },
            "value_type": {
              "const": "number"
            },
            "expected_value": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value_type",
            "expected_value"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "extraction"
            },
            "value_type": {
              "const": "dob_dd_month_yyyy"
            },
            "expected_value": {
              "type": "string",
              "pattern": "^(0[1-9]|[12][0-9]|3[01]) (January|February|March|April|May|June|July|August|September|October|November|December) [0-9]{4}$"
            }
          }
        }
      ]
    }
  }
}
