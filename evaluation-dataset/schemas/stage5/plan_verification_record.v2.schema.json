{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fyp-evaluation.invalid/schemas/stage5/plan_verification_record.v2.schema.json",
  "title": "G5 plan_verification record (schema 2.0, multilingual releases)",
  "description": "Deterministic summary of the accepted plan verifications; rebuilt by --validate. Covers only calls that have an accepted report. A verdict here is the semantic result of a completed verification; current dependency validity is computed separately from the files on disk.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "stage": {
      "const": "G5"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "generator": {
      "type": "object",
      "properties": {
        "package": {
          "const": "fyp_evaluation.plan_verifications"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "version"
      ],
      "additionalProperties": false
    },
    "hashing": {
      "type": "string"
    },
    "upstream": {
      "type": "object",
      "properties": {
        "call_config_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "check_plan_record_sha256": {
          "$ref": "#/$defs/sha256_or_null"
        },
        "checklist_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "check_semantics_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "edge_case_catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalization_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generation_plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "language_profiles_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "call_config_record_sha256",
        "check_plan_record_sha256",
        "checklist_sha256",
        "check_semantics_sha256",
        "edge_case_catalog_sha256",
        "normalization_sha256",
        "generation_plan_sha256",
        "language_profiles_sha256"
      ],
      "additionalProperties": false
    },
    "calls": {
      "type": "object",
      "patternProperties": {
        "^CALL_[0-9]{3,}$": {
          "type": "object",
          "properties": {
            "artifact_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "accepted_attempt_id": {
              "type": "string",
              "pattern": "^A[0-9]{3,}$"
            },
            "verdict": {
              "enum": [
                "VALID",
                "INVALID",
                "UNCLEAR"
              ]
            },
            "recommended_repair": {
              "enum": [
                null,
                "G4_ONLY",
                "G3_PLUS_G4",
                "REVIEW"
              ]
            },
            "observed_service_tier": {
              "type": [
                "string",
                "null"
              ]
            },
            "call_spec_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "check_plan_skeleton_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "call_config_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "check_plan_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "previous_artifact_sha256": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "required": [
            "artifact_sha256",
            "accepted_attempt_id",
            "verdict",
            "recommended_repair",
            "observed_service_tier",
            "call_spec_sha256",
            "check_plan_skeleton_sha256",
            "call_config_sha256",
            "check_plan_sha256",
            "previous_artifact_sha256"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "accepted_calls": {
          "type": "integer",
          "minimum": 0
        },
        "total_calls": {
          "type": "integer",
          "minimum": 1
        },
        "reopened_calls": {
          "type": "integer",
          "minimum": 0
        },
        "verdicts": {
          "type": "object",
          "properties": {
            "VALID": {
              "type": "integer",
              "minimum": 0
            },
            "INVALID": {
              "type": "integer",
              "minimum": 0
            },
            "UNCLEAR": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "VALID",
            "INVALID",
            "UNCLEAR"
          ],
          "additionalProperties": false
        },
        "tier_not_echoed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "accepted_calls",
        "total_calls",
        "reopened_calls",
        "verdicts",
        "tier_not_echoed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "stage",
    "dataset_id",
    "generator",
    "hashing",
    "upstream",
    "calls",
    "summary"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256_or_null": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    }
  }
}
