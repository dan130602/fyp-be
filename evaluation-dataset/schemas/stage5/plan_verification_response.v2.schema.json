{
  "title": "G5 plan verification report",
  "description": "One report per call. Sent to Gemini as the structured-output schema and re-validated by Python with this same file. Uses only the JSON Schema subset Gemini supports (no pattern, const, oneOf or uniqueItems). Python enforces everything this schema cannot express (exact checklist order, issue linkage, evidence grounding) and derives the verdict. Array bounds are limited to the top-level checks array: Gemini rejects (HTTP 400, no detail) this schema when bounds are also set on the arrays nested inside it; Python enforces those limits instead.",
  "type": "object",
  "properties": {
    "checks": {
      "type": "array",
      "description": "Exactly one entry per checklist question, in checklist order (C01..C12, K01, K02, T01..T06).",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string",
            "enum": [
              "C01",
              "C02",
              "C03",
              "C04",
              "C05",
              "C06",
              "C07",
              "C08",
              "C09",
              "C10",
              "C11",
              "C12",
              "K01",
              "K02",
              "T01",
              "T02",
              "T03",
              "T04",
              "T05",
              "T06"
            ]
          },
          "evidence": {
            "type": "array",
            "description": "Ground first: what the generated G3/G4 content actually says. May be empty when the finding is about something absent. At most 6 items (enforced by Python).",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "enum": [
                    "G3",
                    "G4"
                  ]
                },
                "ref": {
                  "type": "string",
                  "description": "G4: an event_id from events. G3: a JSON Pointer into the g3 object, starting with /products or /scenario."
                },
                "quote": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "A verbatim excerpt of the referenced text, or null. Never blank."
                }
              },
              "required": [
                "source",
                "ref",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "rationale": {
            "type": "string",
            "description": "Concise reasoning from the evidence to the assessment (at most 700 characters)."
          },
          "assessment": {
            "type": "string",
            "enum": [
              "MATCH",
              "MISMATCH",
              "UNCLEAR"
            ]
          },
          "issue_ids": {
            "type": "array",
            "description": "Empty for MATCH; at least one issue for MISMATCH or UNCLEAR.",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "question_id",
          "evidence",
          "rationale",
          "assessment",
          "issue_ids"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string",
            "description": "I1, I2, ... in order."
          },
          "assessment": {
            "type": "string",
            "enum": [
              "MISMATCH",
              "UNCLEAR"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "SCENARIO_CONTRADICTION",
              "COMPLIANCE_MEANING",
              "OMISSION_LEAKAGE",
              "EXTRACTION_STATE",
              "EDGE_CASE",
              "PLAN_COHERENCE",
              "LANGUAGE_REQUIREMENT_NOT_MET"
            ]
          },
          "question_ids": {
            "type": "array",
            "description": "Checklist questions this issue affects; empty for a whole-plan issue.",
            "items": {
              "type": "string",
              "enum": [
                "C01",
                "C02",
                "C03",
                "C04",
                "C05",
                "C06",
                "C07",
                "C08",
                "C09",
                "C10",
                "C11",
                "C12",
                "K01",
                "K02",
                "T01",
                "T02",
                "T03",
                "T04",
                "T05",
                "T06"
              ]
            }
          },
          "assignment_ids": {
            "type": "array",
            "description": "Edge-case assignment IDs this issue concerns.",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "enum": [
                    "G3",
                    "G4"
                  ]
                },
                "ref": {
                  "type": "string",
                  "description": "G4: an event_id from events. G3: a JSON Pointer into the g3 object, starting with /products or /scenario."
                },
                "quote": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "A verbatim excerpt of the referenced text, or null. Never blank."
                }
              },
              "required": [
                "source",
                "ref",
                "quote"
              ],
              "additionalProperties": false
            },
            "description": "At most 6 items (enforced by Python); empty for a finding about something absent."
          },
          "explanation": {
            "type": "string"
          },
          "repair_scope": {
            "type": "string",
            "enum": [
              "G4_ONLY",
              "G3_PLUS_G4",
              "REVIEW"
            ]
          }
        },
        "required": [
          "issue_id",
          "assessment",
          "code",
          "question_ids",
          "assignment_ids",
          "evidence",
          "explanation",
          "repair_scope"
        ],
        "additionalProperties": false
      },
      "description": "At most 20 issues (enforced by Python)."
    }
  },
  "required": [
    "checks",
    "issues"
  ],
  "additionalProperties": false
}
