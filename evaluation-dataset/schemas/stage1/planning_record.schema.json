{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fyp-evaluation.invalid/schemas/stage1/planning_record.schema.json",
  "title": "G1 Planning Record",
  "description": "Provenance for one deterministic G1 run: seed, generator, accepted attempt, input/output hashes and review counts. Contains no timestamps so identical inputs reproduce identical bytes. Schema 2.0 records a multilingual release: its summary is per language profile.",
  "type": "object",
  "required": [
    "schema_version",
    "stage",
    "dataset_id",
    "generator",
    "random_seed",
    "attempts",
    "hashing",
    "inputs",
    "outputs",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "2.0"
      ]
    },
    "stage": {
      "const": "G1"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "generator": {
      "type": "object",
      "required": [
        "package",
        "version",
        "rng"
      ],
      "additionalProperties": false,
      "properties": {
        "package": {
          "const": "fyp_evaluation.planning"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "rng": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "random_seed": {
      "type": "integer",
      "minimum": 0
    },
    "attempts": {
      "type": "object",
      "required": [
        "accepted_attempt",
        "rejected_attempts"
      ],
      "additionalProperties": false,
      "properties": {
        "accepted_attempt": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_attempts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hashing": {
      "const": "SHA-256 over UTF-8 bytes with CRLF normalised to LF"
    },
    "inputs": {
      "$ref": "#/$defs/hashes"
    },
    "outputs": {
      "$ref": "#/$defs/hashes"
    },
    "summary": {
      "type": "object"
    }
  },
  "$defs": {
    "hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "summary_v1": {
      "type": "object",
      "required": [
        "calls",
        "duration_profiles",
        "call_composition",
        "compliance_verdicts",
        "fails_per_call",
        "total_compliance_fail_pairs",
        "total_edge_case_assignments",
        "transaction_direction",
        "order_type",
        "transaction_currency",
        "transaction_instrument",
        "edge_case_families",
        "edge_case_ids",
        "edge_case_target_questions",
        "edge_cases_per_call"
      ],
      "additionalProperties": false,
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 1
        },
        "duration_profiles": {
          "$ref": "#/$defs/counts"
        },
        "call_composition": {
          "$ref": "#/$defs/counts"
        },
        "compliance_verdicts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "PASS",
              "FAIL"
            ],
            "additionalProperties": false,
            "properties": {
              "PASS": {
                "type": "integer",
                "minimum": 0
              },
              "FAIL": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "fails_per_call": {
          "$ref": "#/$defs/counts"
        },
        "total_compliance_fail_pairs": {
          "type": "integer",
          "minimum": 0
        },
        "total_edge_case_assignments": {
          "type": "integer",
          "minimum": 0
        },
        "transaction_direction": {
          "$ref": "#/$defs/counts"
        },
        "order_type": {
          "$ref": "#/$defs/counts"
        },
        "transaction_currency": {
          "$ref": "#/$defs/counts"
        },
        "transaction_instrument": {
          "$ref": "#/$defs/counts"
        },
        "edge_case_families": {
          "$ref": "#/$defs/counts"
        },
        "edge_case_ids": {
          "$ref": "#/$defs/counts"
        },
        "edge_case_target_questions": {
          "$ref": "#/$defs/counts"
        },
        "edge_cases_per_call": {
          "$ref": "#/$defs/counts"
        }
      }
    },
    "profile_summary": {
      "type": "object",
      "required": [
        "calls",
        "duration_profiles",
        "call_composition",
        "compliance_verdicts",
        "fails_per_call",
        "total_compliance_fail_pairs",
        "total_edge_case_assignments",
        "transaction_direction",
        "order_type",
        "transaction_currency",
        "transaction_instrument",
        "edge_case_families",
        "edge_case_ids",
        "edge_case_target_questions",
        "edge_cases_per_call",
        "c02_c03_outcomes",
        "language_variants",
        "mixing_styles",
        "target_exposure_calls",
        "fails_plus_edge_cases_by_duration"
      ],
      "additionalProperties": false,
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 1
        },
        "duration_profiles": {
          "$ref": "#/$defs/counts"
        },
        "call_composition": {
          "$ref": "#/$defs/counts"
        },
        "compliance_verdicts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "PASS",
              "FAIL"
            ],
            "additionalProperties": false,
            "properties": {
              "PASS": {
                "type": "integer",
                "minimum": 0
              },
              "FAIL": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "fails_per_call": {
          "$ref": "#/$defs/counts"
        },
        "total_compliance_fail_pairs": {
          "type": "integer",
          "minimum": 0
        },
        "total_edge_case_assignments": {
          "type": "integer",
          "minimum": 0
        },
        "transaction_direction": {
          "$ref": "#/$defs/counts"
        },
        "order_type": {
          "$ref": "#/$defs/counts"
        },
        "transaction_currency": {
          "$ref": "#/$defs/counts"
        },
        "transaction_instrument": {
          "$ref": "#/$defs/counts"
        },
        "edge_case_families": {
          "$ref": "#/$defs/counts"
        },
        "edge_case_ids": {
          "$ref": "#/$defs/counts"
        },
        "edge_case_target_questions": {
          "$ref": "#/$defs/counts"
        },
        "edge_cases_per_call": {
          "$ref": "#/$defs/counts"
        },
        "c02_c03_outcomes": {
          "$ref": "#/$defs/counts"
        },
        "language_variants": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/counts"
          }
        },
        "mixing_styles": {
          "$ref": "#/$defs/counts"
        },
        "target_exposure_calls": {
          "$ref": "#/$defs/counts"
        },
        "fails_plus_edge_cases_by_duration": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/counts"
          }
        }
      }
    },
    "summary_v2": {
      "type": "object",
      "required": [
        "calls",
        "language_profiles",
        "total_compliance_fail_pairs",
        "total_edge_case_assignments",
        "total_language_variants",
        "compliance_fail_counts",
        "by_language_profile"
      ],
      "additionalProperties": false,
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 1
        },
        "language_profiles": {
          "$ref": "#/$defs/counts"
        },
        "total_compliance_fail_pairs": {
          "type": "integer",
          "minimum": 0
        },
        "total_edge_case_assignments": {
          "type": "integer",
          "minimum": 0
        },
        "total_language_variants": {
          "type": "integer",
          "minimum": 0
        },
        "compliance_fail_counts": {
          "$ref": "#/$defs/counts"
        },
        "by_language_profile": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/profile_summary"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "2.0"
          }
        }
      },
      "then": {
        "properties": {
          "summary": {
            "$ref": "#/$defs/summary_v2"
          }
        }
      },
      "else": {
        "properties": {
          "summary": {
            "$ref": "#/$defs/summary_v1"
          }
        }
      }
    }
  ]
}
