{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fyp-evaluation.invalid/schemas/stage3/call_config.schema.json",
  "title": "G3 call_config (Python-owned envelope)",
  "description": "Accepted G3 artifact. Contains no gold and no edge-case parameters: G4 onward load the call spec. The scenario is validated separately against call_config_response.schema.json.",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0"},
    "stage": {"const": "G3"},
    "dataset_id": {"type": "string", "minLength": 1},
    "call_id": {"type": "string", "pattern": "^CALL_[0-9]{3,}$"},
    "call_spec_sha256": {"$ref": "#/$defs/sha256"},
    "check_plan_skeleton_sha256": {"$ref": "#/$defs/sha256"},
    "source": {
      "type": "object",
      "properties": {
        "checklist_sha256": {"$ref": "#/$defs/sha256"},
        "check_semantics_sha256": {"$ref": "#/$defs/sha256"},
        "edge_case_catalog_sha256": {"$ref": "#/$defs/sha256"},
        "normalization_sha256": {"$ref": "#/$defs/sha256"},
        "generation_plan_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["checklist_sha256", "check_semantics_sha256", "edge_case_catalog_sha256", "normalization_sha256", "generation_plan_sha256"],
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "properties": {
        "attempt_id": {"type": "string", "pattern": "^A[0-9]{3,}$"},
        "model": {"type": "string", "minLength": 1},
        "prompt_template_sha256": {"$ref": "#/$defs/sha256"},
        "response_schema_sha256": {"$ref": "#/$defs/sha256"},
        "accepted_response_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["attempt_id", "model", "prompt_template_sha256", "response_schema_sha256", "accepted_response_sha256"],
      "additionalProperties": false
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "product_ref": {"type": "string", "pattern": "^P[0-9]+$"},
          "name": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["FINAL", "CANDIDATE", "INITIAL_ORDER", "SUPERSEDED", "READBACK_ERROR"]}
          }
        },
        "required": ["product_ref", "name", "category", "roles"],
        "additionalProperties": false
      }
    },
    "scenario": {"type": "object"}
  },
  "required": ["schema_version", "stage", "dataset_id", "call_id", "call_spec_sha256", "check_plan_skeleton_sha256", "source", "generation", "products", "scenario"],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
