{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fyp-evaluation.invalid/schemas/stage3/call_config_record.v2.schema.json",
  "title": "G3 call_config record (schema 2.0, multilingual releases)",
  "description": "Deterministic summary of the accepted call configs; rebuilt by --validate and used as the G4 gate. Covers only calls that have an accepted config.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "stage": {
      "const": "G3"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "generator": {
      "type": "object",
      "properties": {
        "package": {
          "const": "fyp_evaluation.call_configs"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "version"
      ],
      "additionalProperties": false
    },
    "hashing": {
      "type": "string"
    },
    "upstream": {
      "type": "object",
      "properties": {
        "call_spec_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "check_plan_skeleton_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "checklist_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "check_semantics_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "edge_case_catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalization_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generation_plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "language_profiles_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "call_spec_record_sha256",
        "check_plan_skeleton_record_sha256",
        "checklist_sha256",
        "check_semantics_sha256",
        "edge_case_catalog_sha256",
        "normalization_sha256",
        "generation_plan_sha256",
        "language_profiles_sha256"
      ],
      "additionalProperties": false
    },
    "calls": {
      "type": "object",
      "patternProperties": {
        "^CALL_[0-9]{3,}$": {
          "type": "object",
          "properties": {
            "artifact_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "accepted_attempt_id": {
              "type": "string",
              "pattern": "^A[0-9]{3,}$"
            },
            "call_spec_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "check_plan_skeleton_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "previous_artifact_sha256": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "required": [
            "artifact_sha256",
            "accepted_attempt_id",
            "call_spec_sha256",
            "check_plan_skeleton_sha256",
            "previous_artifact_sha256"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "accepted_calls": {
          "type": "integer",
          "minimum": 0
        },
        "total_calls": {
          "type": "integer",
          "minimum": 1
        },
        "reopened_calls": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "accepted_calls",
        "total_calls",
        "reopened_calls"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "stage",
    "dataset_id",
    "generator",
    "hashing",
    "upstream",
    "calls",
    "summary"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
