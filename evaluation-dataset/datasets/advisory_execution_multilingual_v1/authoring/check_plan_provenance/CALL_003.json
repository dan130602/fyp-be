        },
        {
          "event_id": "EV_015",
          "speaker": null,
          "text": "请用[[T06]][[T05]][[T01]]，数量是[[T04]]份，交易币种用[[T02]]，委托金额为[[T03]]。我希望尽快成交。",
          "value_forms": [],
