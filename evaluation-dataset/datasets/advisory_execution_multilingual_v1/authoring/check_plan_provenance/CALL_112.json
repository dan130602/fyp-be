          "value_forms": [],
          "readback_question_ids": null
        },
        {
          "event_id": "EV_016",
          "speaker": null,
          "text": "这笔交易的币种用[[T02]]。",
          "value_forms": [],
          "readback_question_ids": null
        },
        {
          "event_id": "EV_017",
