        {
          "speaker": "CLIENT",
          "text": "[[EV_011]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Thank you for your time, Daniel. I'll leave the general account housekeeping for your usual correspondence. Have a good day."
