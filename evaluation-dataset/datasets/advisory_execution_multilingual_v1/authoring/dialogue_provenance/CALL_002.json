        {
          "speaker": "EMPLOYEE",
          "text": "Good morning, private banking, Rachel Tan speaking. Before we discuss your account, may I have your name and identification details?"
        },
        {
          "speaker": "CLIENT",
          "text": "Good morning, Rachel. This is Daniel Lim. [[EV_012]] [[EV_013]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Thank you, Daniel. Are you somewhere comfortable to speak privately? I can keep the conversation focused."
        },
        {
          "speaker": "CLIENT",
          "text": "Yes, I'm in my office with the door closed. [[EV_014]] [[EV_021]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_001]] [[EV_015]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_016]] I would appreciate concise explanations as we go."
        },
