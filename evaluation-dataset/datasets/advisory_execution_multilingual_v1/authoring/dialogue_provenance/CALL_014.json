    "parsed_response": {
      "turns": [
        {
          "speaker": "EMPLOYEE",
          "text": "Good afternoon, Adrian Lim. This is Rachel Tan. Thank you for calling. Are you somewhere comfortable to speak, or would you prefer a moment to settle in?"
        },
        {
          "speaker": "CLIENT",
          "text": "Hi Rachel. Can talk now. Just closed my office door. Whole morning got business calls, then my own admin keeps getting pushed aside. Better clear some of it while the office is quiet."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Certainly. Before we discuss the account, please provide your identification details for our verification process."
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_013]] [[EV_014]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Thank you. Please give me a moment to bring up your account."
        },
        {
          "speaker": "CLIENT",
          "text": "No problem. For the portfolio summaries, keep them concise, can? I read them myself, but long paragraphs quite hard to get through between meetings. Clear headings would help."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "I can note your preference for concise summaries with clear headings. We can keep the administrative discussion brief as well."
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_010]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Before any execution, we still need to complete our discussion. Please take your time if you have anything further to say."
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_011]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_001]] [[EV_007]]"
        },
        {
          "speaker": "CLIENT",
          "text": "Okay, noted. [[EV_015]] [[EV_012]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_002]] [[EV_006]] [[EV_003]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_004]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_005]] I also have your preference about the presentation of correspondence noted."
        },
        {
          "speaker": "CLIENT",
          "text": "Thanks. Sometimes I open a document on my phone outside a meeting room. If everything squeezed together, very easy to lose my place. More spacing would be good."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "I will include that formatting preference in the note. Shall I allow a brief pause before continuing?"
        },
        {
          "speaker": "CLIENT",
          "text": "No need, still here. My assistant knows not to put calls through while the door is closed. Messages still coming in though."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_008]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_009]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Of course. We can end the call here while you attend to your message, and speak again when you are available."
        },
        {
          "speaker": "CLIENT",
          "text": "Call you back. Thanks, Rachel."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Thank you for your time. Goodbye."
        },
        {
          "speaker": "CLIENT",
          "text": "Bye."
        }
      ]
