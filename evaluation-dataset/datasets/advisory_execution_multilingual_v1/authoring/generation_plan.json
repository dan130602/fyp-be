  "planning_rules": {
    "g1_must_be_deterministic": true,
    "g1_must_not_use_llm": true,
    "coverage_matrix_is_source_of_truth_for_check_answers": true,
    "call_manifest_is_source_of_truth_for_call_level_attributes": true,
    "edge_case_assignments_are_source_of_truth_for_challenge_placement": true,
    "allocate_edge_cases_and_compliance_verdicts_jointly": true,
    "edge_case_forced_verdicts_count_toward_failure_budget": true,
    "gold_values_must_satisfy_edge_case_prerequisites_when_assigned": true,
    "complete_order_replacement_excludes_other_transaction_correction_edge_cases_in_same_call": true,
    "max_edge_cases_per_target_question_per_call": 1,
    "per_question_limit_exempt_edge_cases": [
      "EC_LONG_DISTANCE_DEPENDENCY"
    ],
    "superseded_and_distractor_values_must_satisfy_domain_and_realism_constraints": true,
    "complete_order_replacement_initial_order_must_be_plausible": true,
    "no_fee_distractor_when_c04_fail": true,
    "unspecified_choices_strategy": "SEEDED_BALANCED_STABLE_TIE_BREAK",
    "call_intents_are_multilabel": true,
    "call_intents_are_descriptive_only": true,
    "call_intent_vocabulary_order_is_canonical": true,
    "call_intents_csv_encoding": "PIPE_DELIMITED",
    "call_intents_json_encoding": "ARRAY",
    "language_profile_is_frozen_per_call": true,
    "allocations_are_exact_per_language_profile": true,
    "fail_counts_per_check_are_exact": true,
    "edge_case_counts_are_exact": true,
    "language_variants_never_add_assignments": true,
    "prohibition_question_ids": [
      "C09",
      "C10",
      "C11",
      "C12"
    ],
    "max_prohibition_fails_per_call": 1,
    "load_cap": {
      "duration_profile": "SHORT",
      "max_fails_plus_edge_cases": 6
    },
    "dependent_fail_rules": [
      {
        "question_id": "C03",
        "fails_only_with": {
          "failed_question_id": "C02",
          "or_edge_case_id": "EC_RISK_EXPLAINED_UNDERSTANDING_NOT_VERIFIED"
        },
        "note": "New-release generation rule: C02 PASS with C03 FAIL is planned only through the risk-explained/understanding-not-verified edge case, so every such call carries that assignment. It does not redefine check_semantics; G5/G7 still verify the actual wording."
      }
    ],
    "call_id_assignment": "SEEDED_INTERLEAVE_ACROSS_PROFILES"
