  "language_rules": {
    "zh": {
      "script": "SIMPLIFIED_HAN",
      "cardinal": "Han numerals with 万/亿 grouping (五万 = 50000, 一百二十万 = 1200000, 一亿 = 100000000); 零 marks an internal gap (一万零五十). 两 is used only for a leading digit 2 immediately before 百, 千, 万 or 亿 (两百, 两千, 两万五千); 二 everywhere else (二十, 十二, 一百二十, 两千二百). Decoders accept 两 or 二 in cardinal positions only.",
      "year": "Digit by digit with 〇 for zero (一九九八, 二〇〇一); 二 always.",
      "date": "YYYY年M月D日: year digit by digit, month and day as cardinals without a leading zero; decodes to the canonical DD Month YYYY.",
      "identifier": "NRIC/FIN prefix and suffix letters stay uppercase Latin; each digit is 零一二三四五六七八九 (二 always, never 两 or 幺).",
      "decimal": "点 separates the decimal part, read digit by digit (百分之一点五, 十二点五).",
      "percentage": "百分之 followed by the cardinal.",
      "decoding": "Decoders never consult the expected value; ambiguous or unparseable surfaces are rejected.",
      "deferred": [
        "Shortened colloquial numbers such as 一千二 or 两万五 are not generated in this release.",
        "幺 for the digit one is not generated in this release.",
        "Compact Mandarin repeated-digit expressions are not generated in this release."
      ]
    }
  }
