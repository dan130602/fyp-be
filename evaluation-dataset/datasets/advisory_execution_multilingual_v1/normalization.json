{
  "schema_version": "2.0",
  "dataset_id": "advisory_execution_multilingual_v1",
  "description": "Release-local normalization contract for advisory_execution_multilingual_v1. It owns canonical gold forms, accepted aliases, per-language spoken/reference-text forms, per-value generation surfaces (the allowlist Python renders from) and prediction-comparison steps for every extraction profile referenced by check_semantics.json. Each spoken form names its language; a call may use only the forms of its language profile's value_surface_languages. Spoken forms marked EDGE_CASE_ONLY are REQUIRED on the targeted value when their edge case is assigned and FORBIDDEN in every call where it is not. Gold values never change with language. This file is declarative: Mandarin rendering and decoding are implemented later.",
  "implementation_status": "DECLARATIVE_ONLY",
  "compliance_verdicts": [
    "PASS",
    "FAIL"
  ],
  "profiles": {
    "synthetic_nric_fin": {
      "value_type": "text",
      "description": "Synthetic Singapore NRIC/FIN-shaped identifier used for K01.",
      "canonical": {
        "format": "One uppercase prefix letter, seven digits and one uppercase suffix letter, with no spaces or punctuation.",
        "pattern": "^[STFGM][0-9]{7}[A-NP-Z]$",
        "excluded_characters": [
          "O"
        ],
        "excluded_characters_reason": "The letter O is acoustically ambiguous with the digit zero spoken as 'oh'."
      },
      "comparison": {
        "steps": [
          "TRIM",
          "SPOKEN_CHARACTERS_TO_SYMBOLS",
          "REMOVE_SEPARATORS",
          "UPPERCASE",
          "EXACT_MATCH"
        ],
        "on_ambiguous_or_unparseable": "REJECT",
        "notes": [
          "SPOKEN_CHARACTERS_TO_SYMBOLS covers digit words zero-nine, 'oh' for zero, and 'double'/'triple' digit runs.",
          "Checksum validity is never repaired or used for comparison."
        ]
      },
      "reference_text": {
        "default_form": "CHARACTER_BY_CHARACTER",
        "notes": [
          "Letters and digits are spoken individually, every zero included."
        ]
      },
      "spoken_forms": [
        {
          "id": "CHARACTER_BY_CHARACTER",
          "usage": "DEFAULT",
          "description": "Each letter and digit is spoken separately.",
          "language": "en"
        },
        {
          "id": "OH_FOR_ZERO",
          "usage": "EDGE_CASE_ONLY",
          "description": "Every zero digit in the identifier is spoken as 'oh'; all other characters stay character by character.",
          "enabled_by_edge_case": "EC_OH_VS_ZERO",
          "applies_to": "ALL_ZERO_DIGITS",
          "remaining_characters_form": "CHARACTER_BY_CHARACTER",
          "language": "en"
        },
        {
          "id": "DOUBLE_OR_TRIPLE_DIGIT",
          "usage": "EDGE_CASE_ONLY",
          "description": "Every maximal run of identical digits whose length equals the assigned variant (DOUBLE = 2, TRIPLE = 3) is spoken as 'double' or 'triple' followed by the digit; all other characters stay character by character.",
          "enabled_by_edge_case": "EC_DOUBLE_TRIPLE_DIGITS",
          "applies_to": "ALL_RUNS_OF_ASSIGNED_VARIANT_LENGTH",
          "remaining_characters_form": "CHARACTER_BY_CHARACTER",
          "language": "en"
        },
        {
          "id": "ZH_CHARACTER_BY_CHARACTER",
          "usage": "DEFAULT",
          "language": "zh",
          "description": "Latin prefix and suffix letters with each digit read as a Mandarin digit (二 always)."
        }
      ]
    },
