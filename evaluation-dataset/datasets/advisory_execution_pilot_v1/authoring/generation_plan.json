    "g1_must_not_use_llm": true,
    "coverage_matrix_is_source_of_truth_for_check_answers": true,
    "call_manifest_is_source_of_truth_for_call_level_attributes": true,
    "edge_case_assignments_are_source_of_truth_for_challenge_placement": true,
    "allocate_edge_cases_and_compliance_verdicts_jointly": true,
    "edge_case_forced_verdicts_count_toward_failure_budget": true,
    "gold_values_must_satisfy_edge_case_prerequisites_when_assigned": true,
    "complete_order_replacement_excludes_other_transaction_correction_edge_cases_in_same_call": true,
    "max_edge_cases_per_target_question_per_call": 1,
    "per_question_limit_exempt_edge_cases": [
      "EC_LONG_DISTANCE_DEPENDENCY"
    ],
    "superseded_and_distractor_values_must_satisfy_domain_and_realism_constraints": true,
    "complete_order_replacement_initial_order_must_be_plausible": true,
    "no_fee_distractor_when_c04_fail": true,
    "unspecified_choices_strategy": "SEEDED_BALANCED_STABLE_TIE_BREAK",
    "call_intents_are_multilabel": true,
    "call_intents_are_descriptive_only": true,
