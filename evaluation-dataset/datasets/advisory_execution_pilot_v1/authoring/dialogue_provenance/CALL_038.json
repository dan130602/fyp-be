    "parsed_response": {
      "turns": [
        {
          "speaker": "EMPLOYEE",
          "text": "Hello Rachel, Daniel Lim here from the bank. Thanks for making time for our telephone appointment. Are you somewhere comfortable to speak, or are you still moving between meetings?"
        },
        {
          "speaker": "CLIENT",
          "text": "Hi Daniel. I'm in my office now, with the door closed. Telephone appointments work better for me these days. Getting away from the office for a branch visit takes quite a bit of arranging."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "No problem, we can keep our conversation concise. Before we start, please give me your identity details for the usual verification. You can take your time."
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_011]] [[EV_012]] [[EV_013]] I've been looking at the staff calendar while talking, so let me put that aside."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Thank you, Rachel. Let's move to the discussion you requested. [[EV_001]] [[EV_002]] [[EV_003]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_004]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_005]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_006]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_007]] [[EV_010]]"
        },
        {
          "speaker": "CLIENT",
          "text": "I'll set out what I have in mind together, rather than jumping between my notes. [[EV_014]] [[EV_017]] [[EV_018]] [[EV_015]] [[EV_016]] [[EV_019]] [[EV_020]] [[EV_021]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_008]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_009]] My operations manager is looking for me. It's been one of those afternoons where everyone seems to need a reply at the same time."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "I'll leave you to attend to your work, then. For future telephone appointments, would you prefer that I contact you directly to arrange a suitable slot?"
        },
        {
          "speaker": "CLIENT",
          "text": "Yes, directly is best. My assistant handles the business diary, but I keep my personal appointments myself. Usually a short call before the afternoon meetings is easier."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Noted on the appointment arrangement. I'll avoid going through your office team. You can also message me when your diary settles, rather than trying to find a slot while you're busy."
        },
        {
          "speaker": "CLIENT",
          "text": "That would help. Sorry, someone is at the door now as well. I need to get back to the office matters."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Of course, Rachel. Thanks for your time today. I'll let you go. Goodbye."
        },
        {
          "speaker": "CLIENT",
          "text": "Thanks, Daniel. Bye."
        }
      ]
