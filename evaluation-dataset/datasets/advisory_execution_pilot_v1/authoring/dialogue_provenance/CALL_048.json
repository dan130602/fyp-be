    "parsed_response": {
      "turns": [
        {
          "speaker": "EMPLOYEE",
          "text": "Good morning, Adrian. Melissa Goh speaking. Nice to hear from you. Are you somewhere you can speak privately?"
        },
        {
          "speaker": "CLIENT",
          "text": "Hi, Melissa. Yes, I'm in my office with the door closed. I've got a staff meeting shortly, so I'd prefer to handle this over the phone. Going down to the branch is quite difficult these days."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Certainly. We can keep the conversation focused. Before we get into it, let's do the identity checks. Please have your own details ready."
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_014]] [[EV_013]] [[EV_015]] Sorry, there are several folders on my desk and I picked up the wrong one."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Thank you, Adrian. No need to rush through the paperwork. I'm listening."
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_016]] [[EV_022]] [[EV_017]] [[EV_018]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "I'll let you finish speaking before I take you through the remaining points."
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_019]] [[EV_020]] [[EV_021]] [[EV_023]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_001]] [[EV_002]] [[EV_003]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_004]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_005]] [[EV_006]] [[EV_007]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_008]] Sorry if I sound distracted. Managing the family business means people are always knocking on the door, even when I've blocked out time for a call."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "No problem. I'll keep to the points we need to cover. [[EV_009]]"
        },
        {
          "speaker": "CLIENT",
          "text": "Thanks. Telephone contact is still the easiest way to reach me. If I'm with the warehouse team, I may miss the first ring, but I'll call back when I'm somewhere quiet."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "I'll note your contact preference. [[EV_010]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_011]] [[EV_012]] I really have to get back to the office discussion now."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "That information needs internal review. I won't take any processing action during this call. I'll refer the matter to the appropriate team and contact you separately. You can return to your meeting."
        },
        {
          "speaker": "CLIENT",
          "text": "All right, Melissa. Please use the telephone when you need to reach me. I need to go now. Bye."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Noted, Adrian. Thank you for your time. Goodbye."
