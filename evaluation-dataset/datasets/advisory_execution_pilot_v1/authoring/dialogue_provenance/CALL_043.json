    "parsed_response": {
      "turns": [
        {
          "speaker": "EMPLOYEE",
          "text": "Good afternoon, Adrian. Rachel Tan here. Thanks for setting aside time for our telephone appointment. Are you somewhere comfortable to speak privately?"
        },
        {
          "speaker": "CLIENT",
          "text": "Hi Rachel. Yes, I'm in my office with the door closed. Telephone appointments are easier for me than coming down, especially between meetings."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Of course. We can keep this concise. Before we begin, could you provide your identification particulars for the usual verification?"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_012]] [[EV_013]] I've got a little breathing space now; my next business appointment is later."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Thank you. It's helpful to have a quiet slot rather than fit personal administration in while you're rushing. [[EV_001]]"
        },
        {
          "speaker": "CLIENT",
          "text": "I usually put these appointments in my diary, same as business meetings. Otherwise the paperwork just sits there. [[EV_014]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "I'll keep the discussion straightforward. [[EV_009]] [[EV_002]] [[EV_003]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_004]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_005]] [[EV_006]] [[EV_007]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_008]] [[EV_016]] [[EV_019]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_018]] I'll leave a pause here so you have room to speak without me interrupting."
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_015]] [[EV_017]] [[EV_020]] [[EV_021]] [[EV_024]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_022]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_023]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Sorry about that, Adrian. Thank you for catching my mistake. [[EV_010]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_011]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Thank you. For any routine follow-up, would you prefer a telephone appointment again, or an email to arrange a suitable slot?"
        },
        {
          "speaker": "CLIENT",
          "text": "An email to arrange the slot is best. During the workday I may not pick up an unexpected call, but a planned appointment is easy enough."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Noted. We'll use that approach for scheduling. Thanks for your time today, Adrian. I'll let you get back to your afternoon."
        },
        {
          "speaker": "CLIENT",
          "text": "Thanks, Rachel. Appreciate keeping it brief. Have a good afternoon, bye."
        }
      ]
