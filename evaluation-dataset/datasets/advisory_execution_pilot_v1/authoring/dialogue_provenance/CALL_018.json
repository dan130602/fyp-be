    "parsed_response": {
      "turns": [
        {
          "speaker": "EMPLOYEE",
          "text": "Good afternoon, Clara. Adrian Lim here. Thanks for setting aside time for our telephone appointment. Are you somewhere comfortable to speak privately?"
        },
        {
          "speaker": "CLIENT",
          "text": "Hi Adrian, yes, I'm in my office with the door closed. Telephone appointments suit me better these days. I can fit them between meetings without travelling down."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "That's convenient. We can keep today's conversation concise. Before we get into it, please give me your identification number and date of birth for verification."
        },
        {
          "speaker": "CLIENT",
          "text": "Sure, let me do that first. [[EV_012]] [[EV_013]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Thank you. How has your work routine been lately? Last time, you mentioned spending quite a lot of time at the family business."
        },
        {
          "speaker": "CLIENT",
          "text": "I've started coming in earlier and leaving the afternoon meetings to my operations manager. It gives me a quieter window for personal administration. [[EV_014]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "All right, let's cover the key points first. [[EV_001]] [[EV_002]] [[EV_003]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_004]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_005]] [[EV_006]] [[EV_007]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_008]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_009]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_020]] [[EV_018]] [[EV_019]] [[EV_021]] [[EV_015]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "I'll give you a moment with your account information. There's no need to rush while you're looking through your paperwork."
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_016]] My desk is a bit crowded today. I've got the business meeting papers beside my personal folder, so let me move those aside."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "No problem, take your time. I'll stay on the line while you find the page you need."
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_017]] Thanks for waiting. I have the right page in front of me now."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_010]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_011]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Thank you, Clara. For future appointments, would you prefer that I contact you by telephone again rather than arrange a branch visit?"
        },
        {
          "speaker": "CLIENT",
          "text": "Yes, please. A scheduled call is easier, especially while I'm settling into this new routine. Just send me a message beforehand so I can block out the time."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Certainly. I'll use our usual appointment arrangements. Thank you for your time today."
        },
        {
          "speaker": "CLIENT",
          "text": "Thanks, Adrian. Have a good afternoon. Bye."
        }
      ]
