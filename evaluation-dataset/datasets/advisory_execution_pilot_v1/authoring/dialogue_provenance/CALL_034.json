    "parsed_response": {
      "turns": [
        {
          "speaker": "EMPLOYEE",
          "text": "Good morning, Ms Tan. Adrian Lim here from the bank. Thanks for making time for our telephone appointment. Are you somewhere you can speak privately, or would you prefer that I call back?"
        },
        {
          "speaker": "CLIENT",
          "text": "Morning, Adrian. I can speak now. I've closed my office door. Telephone appointments are easier for me, actually; going down to the branch takes quite a bit of arranging."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Certainly, we can keep it brief. Before we begin, could you give me your identification details for verification?"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_011]] [[EV_012]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Thank you. Before we move on, were you able to find your account documents in the banking app?"
        },
        {
          "speaker": "CLIENT",
          "text": "Yes, though I had to look around a little. I normally use it just to check my account. Can I download the documents rather than only view them?"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "You can open the document and use the download option where it's available. If you have trouble locating it, I can arrange app support separately. [[EV_001]]"
        },
        {
          "speaker": "CLIENT",
          "text": "All right, I'll try that later when I'm at my desk properly. [[EV_013]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_002]] [[EV_004]] [[EV_003]] [[EV_005]]"
        },
        {
          "speaker": "CLIENT",
          "text": "Let me think for a moment. [[EV_006]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_010]]"
        },
        {
          "speaker": "CLIENT",
          "text": "Please keep my earlier answer exactly as I gave it. I'd prefer that my own words stay on the record."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "I've noted what you said. [[EV_007]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_014]] [[EV_015]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "I'll have the operations team check the settlement arrangements against the account information on file. Any administrative questions can be followed up with you directly."
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_018]] [[EV_016]] [[EV_017]] [[EV_019]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_020]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_021]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_008]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_009]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Thank you, Ms Tan. For any follow-up telephone appointment, shall we contact you on this number? We can also help with locating your documents in the app if needed."
        },
        {
          "speaker": "CLIENT",
          "text": "Yes, use this number. Please call rather than send a long email if you need to reach me. I'll check the app later. Thanks, Adrian, goodbye."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Certainly. Thank you for your time today. Goodbye, Ms Tan."
        }
      ]
