          "text": "[[EV_008]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_009]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_015]] [[EV_016]] [[EV_017]] [[EV_019]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "[[EV_010]]"
        },
        {
          "speaker": "CLIENT",
          "text": "[[EV_011]]"
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Thank you, Elaine. For any administrative follow-up, would you prefer a telephone call rather than having to arrange a branch visit?"
        },
        {
          "speaker": "CLIENT",
          "text": "A telephone call, please. If I miss it, leave a message asking me to ring you back. No need to put anything detailed in the message."
        },
        {
          "speaker": "EMPLOYEE",
          "text": "Of course. I'll note that contact preference. That's everything for our call today. Thank you for setting aside the time, and enjoy the rest of your afternoon."
        },
        {
          "speaker": "CLIENT",
          "text": "Thanks, Adrian. This timing worked well for me. I'll get back to my day now. Goodbye."
